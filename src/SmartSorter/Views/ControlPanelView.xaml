<UserControl x:Class="SmartSorter.Views.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="1200"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- 제어 패널 전용 rounded 버튼 스타일 (비활성화 시 색상/호버 완전 차단) -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 1. 마우스 호버 (활성화 상태일 때만 연해짐) -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </MultiTrigger>

                            <!-- 2. 클릭 시 (활성화 상태일 때만 반응) -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Opacity" TargetName="border" Value="0.70"/>
                            </MultiTrigger>

                            <!-- 💡 3. 비활성화(IsEnabled=False) 시 : 원색 완전히 끄고 회색톤 + 금지 커서 처리 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="No"/>
                                <Setter TargetName="border" Property="Background" Value="#9CA3AF"/>
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                                <Setter Property="Opacity" TargetName="border" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 외곽 마진과 패딩을 최소화하여 화면 양끝으로 꽉 차게 확장 -->
    <Border Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Color="#CCCCCC" Direction="270" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" 
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <!-- 좌측: 모니터링 & 수량 현황 (50%) -->
                    <ColumnDefinition Width="1*"/>
                    <!-- 간격 -->
                    <ColumnDefinition Width="15"/>
                    <!-- 우측: 장치 & 서보모터 제어 (50%) -->
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= 👈 [좌측 영역] 모니터링 & 수량 현황 ================= -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Stretch">

                    <!-- 1. 공정 운전 상태 램프 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="🚥 공정 운전 상태" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Ellipse Width="42" Height="42" Fill="#10B981"/>
                                    <TextBlock Text="작동" FontSize="12" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Ellipse Width="42" Height="42" Fill="#EAB308"/>
                                    <TextBlock Text="정지/대기" FontSize="12" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <Ellipse Width="42" Height="42" Fill="#CBD5E1"/>
                                    <TextBlock Text="비상" FontSize="12" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. 실시간 분류 수량 현황 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="📦 실시간 분류 현황" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- RED -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Margin="4" Padding="12,10" HorizontalAlignment="Stretch">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="🔴 RED" Foreground="#DC2626" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RedCount, FallbackValue=0}" Foreground="#DC2626" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- GREEN -->
                                <Border Grid.Row="0" Grid.Column="1" Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="6" Margin="4" Padding="12,10" HorizontalAlignment="Stretch">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="🟢 GREEN" Foreground="#059669" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GreenCount, FallbackValue=0}" Foreground="#059669" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- BLUE -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Margin="4" Padding="12,10" HorizontalAlignment="Stretch">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="🔵 BLUE" Foreground="#2563EB" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BlueCount, FallbackValue=0}" Foreground="#2563EB" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- YELLOW -->
                                <Border Grid.Row="1" Grid.Column="1" Background="#FEFCE8" BorderBrush="#FDE047" BorderThickness="1" CornerRadius="6" Margin="4" Padding="12,10" HorizontalAlignment="Stretch">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="🟡 YELLOW" Foreground="#CA8A04" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding YellowCount, FallbackValue=0}" Foreground="#CA8A04" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- TOTAL -->
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="4" Padding="12,10" HorizontalAlignment="Stretch">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="📦 TOTAL (전체 합계)" Foreground="#475569" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalCount, FallbackValue=0}" Foreground="#1E293B" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. 통신 상태 모니터링 -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="15" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="🔌 통신 상태 모니터링" FontWeight="Bold" Foreground="#374151" FontSize="14" Margin="0,0,0,10"/>

                            <DockPanel LastChildFill="True" Margin="0,5">
                                <TextBlock Text="PLC (Modbus):" Foreground="#6B7280" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PlcConnectionStatusText, FallbackValue='미연결'}" HorizontalAlignment="Right" Foreground="{Binding PlcConnectionColor, FallbackValue='#EF4444'}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>

                            <DockPanel LastChildFill="True" Margin="0,5">
                                <TextBlock Text="USB Camera:" Foreground="#6B7280" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CameraStatusText, FallbackValue='대기중'}" HorizontalAlignment="Right" Foreground="{Binding CameraStatusColor, FallbackValue='#6B7280'}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>


                <!-- ================= 👉 [우측 영역] 장치 & 서보모터 제어 ================= -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">

                    <!-- 1. 장치 제어 (컨베이어 / 리셋 + PLC 연결 버튼) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="🎮 장치 및 통신 제어" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                            <!-- 상단: 컨베이어 / 리셋 버튼 -->
                            <Grid HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <Button Command="{Binding StartConveyorCommand}" Height="40" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="Content" Value="▶ 컨베이어 가동"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConveyorRunning}" Value="True">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Content" Value="⏹ 컨베이어 정지"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="2" Content="↺ 리셋" Command="{Binding ResetSystemCommand}" Height="40" Background="#DC2626" Style="{StaticResource RoundedButtonStyle}"/>
                            </Grid>

                            <!-- 하단: PLC 통신 연결 / 해제 버튼 -->
                            <Button Command="{Binding ConnectPlcCommand}" Height="40" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Content" Value="🔌 PLC 통신 연결하기"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Setter Property="Content" Value="🟢 PLC 통신 연결 해제"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 🔒 2. 수동 모드 전용 서보 제어 패널 (Manual일 때만 IsEnabled=True) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsManualMode}">
                        <StackPanel HorizontalAlignment="Stretch">
                            <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                <TextBlock Text="🖐️ 수동 모드 서보 제어 테스트" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

                                <!-- 💡 모드 상태에 따라 안내 문구 가변 처리 -->
                                <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🔒 수동(Manual) 모드에서만 활성화됩니다"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsManualMode}" Value="True">
                                                    <Setter Property="Text" Value="🔓 수동 제어 가능 상태"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- RED -->
                                <Button Grid.Column="0" Content="🔴 RED" Command="{Binding ManualTestCommand}" CommandParameter="Red"
                                        Height="38" Margin="0,0,4,0" Background="#EF4444" Style="{StaticResource RoundedButtonStyle}"/>

                                <!-- GREEN -->
                                <Button Grid.Column="1" Content="🟢 GREEN" Command="{Binding ManualTestCommand}" CommandParameter="Green"
                                        Height="38" Margin="2,0" Background="#10B981" Style="{StaticResource RoundedButtonStyle}"/>

                                <!-- BLUE -->
                                <Button Grid.Column="2" Content="🔵 BLUE" Command="{Binding ManualTestCommand}" CommandParameter="Blue"
                                        Height="38" Margin="2,0" Background="#3B82F6" Style="{StaticResource RoundedButtonStyle}"/>

                                <!-- YELLOW -->
                                <Button Grid.Column="3" Content="🟡 YELLOW" Command="{Binding ManualTestCommand}" CommandParameter="Yellow"
                                        Height="38" Margin="4,0,0,0" Background="#F59E0B" Style="{StaticResource RoundedButtonStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. 서보모터 1번 제어 -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Stretch">
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <TextBlock Text="서보모터 #1 (분류기 A)" FontWeight="Bold" Foreground="#374151" FontSize="13"/>
                                <TextBlock Text="{Binding ServoAngle1, StringFormat={}{0}°}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#0D6EFD" FontSize="14"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="180" Value="{Binding ServoAngle1}" TickFrequency="5" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch"/>
                            <Button Content="1번 서보 각도 전송" Command="{Binding SendServoAngleCommand}" CommandParameter="1" Margin="0,10,0,0" Height="36" Background="#0D6EFD" Style="{StaticResource RoundedButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. 서보모터 2번 제어 -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="15" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Stretch">
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <TextBlock Text="서보모터 #2 (분류기 B)" FontWeight="Bold" Foreground="#374151" FontSize="13"/>
                                <TextBlock Text="{Binding ServoAngle2, StringFormat={}{0}°}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#0D6EFD" FontSize="14"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="180" Value="{Binding ServoAngle2}" TickFrequency="5" IsSnapToTickEnabled="True" HorizontalAlignment="Stretch"/>
                            <Button Content="2번 서보 각도 전송" Command="{Binding SendServoAngleCommand}" CommandParameter="2" Margin="0,10,0,0" Height="36" Background="#0D6EFD" Style="{StaticResource RoundedButtonStyle}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>